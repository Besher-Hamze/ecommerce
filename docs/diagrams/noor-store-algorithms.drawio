  <diagram id="page1" name="1. البيانات والمنهجية">
    <mxGraphModel dx="1600" dy="900" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="900" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="c2" value="&lt;div dir=&quot;rtl&quot;&gt;منهجية البحث وبيانات المتجر&lt;/div&gt;" style="text;html=1;fontSize=28;fontStyle=1;fontColor=#6A1B4D;align=center;verticalAlign=middle;fontFamily=Tahoma;" vertex="1" parent="1">
          <mxGeometry x="40" y="15" width="1520" height="50" as="geometry" />
        </mxCell>
        <mxCell id="c3" value="&lt;div dir=&quot;rtl&quot;&gt;دراسة تطبيقية على متجر مستحضرات تجميل — Noor-Store&lt;/div&gt;" style="text;html=1;fontSize=16;fontColor=#555555;align=center;verticalAlign=middle;fontFamily=Tahoma;" vertex="1" parent="1">
          <mxGeometry x="40" y="65" width="1520" height="35" as="geometry" />
        </mxCell>
        <mxCell id="c4" value="&lt;div dir=&quot;rtl&quot;&gt;Noor-Store · ورقة بحثية — تحسين تجربة المستخدم باستخدام أنظمة التوصية&lt;/div&gt;" style="text;html=1;fontSize=12;fontColor=#999999;align=center;verticalAlign=middle;fontFamily=Tahoma;" vertex="1" parent="1">
          <mxGeometry x="40" y="865" width="1520" height="25" as="geometry" />
        </mxCell>
        <mxCell id="c5" value="&lt;div dir=&quot;rtl&quot;&gt;&lt;b style=&#39;font-size:26px&#39;&gt;914&lt;/b&gt;&lt;br&gt;منتج&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=14;fontSize=16;spacing=8;fontFamily=Tahoma;fillColor=#6A1B4D;strokeColor=#6A1B4D;strokeWidth=2;fontColor=#FFFFFF;fontStyle=1;fontSize=18;" vertex="1" parent="1">
          <mxGeometry x="80" y="120" width="230" height="90" as="geometry" />
        </mxCell>
        <mxCell id="c6" value="&lt;div dir=&quot;rtl&quot;&gt;&lt;b style=&#39;font-size:26px&#39;&gt;500&lt;/b&gt;&lt;br&gt;زبون&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=14;fontSize=16;spacing=8;fontFamily=Tahoma;fillColor=#6A1B4D;strokeColor=#6A1B4D;strokeWidth=2;fontColor=#FFFFFF;fontStyle=1;fontSize=18;" vertex="1" parent="1">
          <mxGeometry x="330" y="120" width="230" height="90" as="geometry" />
        </mxCell>
        <mxCell id="c7" value="&lt;div dir=&quot;rtl&quot;&gt;&lt;b style=&#39;font-size:26px&#39;&gt;2,778&lt;/b&gt;&lt;br&gt;طلب&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=14;fontSize=16;spacing=8;fontFamily=Tahoma;fillColor=#6A1B4D;strokeColor=#6A1B4D;strokeWidth=2;fontColor=#FFFFFF;fontStyle=1;fontSize=18;" vertex="1" parent="1">
          <mxGeometry x="580" y="120" width="230" height="90" as="geometry" />
        </mxCell>
        <mxCell id="c8" value="&lt;div dir=&quot;rtl&quot;&gt;&lt;b style=&#39;font-size:26px&#39;&gt;2,626&lt;/b&gt;&lt;br&gt;سلة مكتملة&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=14;fontSize=16;spacing=8;fontFamily=Tahoma;fillColor=#6A1B4D;strokeColor=#6A1B4D;strokeWidth=2;fontColor=#FFFFFF;fontStyle=1;fontSize=18;" vertex="1" parent="1">
          <mxGeometry x="830" y="120" width="230" height="90" as="geometry" />
        </mxCell>
        <mxCell id="c9" value="&lt;div dir=&quot;rtl&quot;&gt;&lt;b style=&#39;font-size:26px&#39;&gt;20,411&lt;/b&gt;&lt;br&gt;مشاهدة&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=14;fontSize=16;spacing=8;fontFamily=Tahoma;fillColor=#6A1B4D;strokeColor=#6A1B4D;strokeWidth=2;fontColor=#FFFFFF;fontStyle=1;fontSize=18;" vertex="1" parent="1">
          <mxGeometry x="1080" y="120" width="230" height="90" as="geometry" />
        </mxCell>
        <mxCell id="c10" value="&lt;div dir=&quot;rtl&quot;&gt;&lt;b style=&#39;font-size:26px&#39;&gt;1,836&lt;/b&gt;&lt;br&gt;تقييم&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=14;fontSize=16;spacing=8;fontFamily=Tahoma;fillColor=#6A1B4D;strokeColor=#6A1B4D;strokeWidth=2;fontColor=#FFFFFF;fontStyle=1;fontSize=18;" vertex="1" parent="1">
          <mxGeometry x="1330" y="120" width="230" height="90" as="geometry" />
        </mxCell>
        <mxCell id="c11" value="&lt;div dir=&quot;rtl&quot;&gt;&lt;b&gt;قصة البحث&lt;/b&gt;&lt;br&gt;في متاجر التجميل الزبون غالباً يبحث عن روتين كامل (أحمر شفاه + محدد + أحمر خدود)،&lt;br&gt;ولا يكتفي بمنتج واحد. الهدف الأكاديمي: هل أنظمة التوصية تحسّن تجربة الشراء فعلاً؟&lt;br&gt;طبقنا ثلاث خوارزميات كلاسيكية، وربطناها بواجهة المتجر، ثم قيّمناها رقمياً.&lt;/div&gt;" style="shape=note;whiteSpace=wrap;html=1;size=18;fillColor=#FFF2CC;strokeColor=#D6B656;strokeWidth=2;fontSize=15;align=center;verticalAlign=middle;spacing=10;fontFamily=Tahoma;" vertex="1" parent="1">
          <mxGeometry x="80" y="240" width="760" height="200" as="geometry" />
        </mxCell>
        <mxCell id="c12" value="&lt;div dir=&quot;rtl&quot;&gt;&lt;b&gt;تصميم التقييم (Hold-out)&lt;/b&gt;&lt;br&gt;1. أخفينا آخر طلب لكل زبون (488 سلة اختبار)&lt;br&gt;2. درّبنا الخوارزميات على الطلبات الأقدم (2,138 سلة)&lt;br&gt;3. سألنا: هل المنتج المخفي ظهر ضمن أول 5 اقتراحات؟&lt;br&gt;4. قارنّا مع خط أساس: الأكثر مبيعاً + اقتراح عشوائي&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=14;fontSize=16;spacing=8;fontFamily=Tahoma;fillColor=#F5F5F5;strokeColor=#888888;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="880" y="240" width="640" height="200" as="geometry" />
        </mxCell>
        <mxCell id="c13" value="&lt;div dir=&quot;rtl&quot;&gt;&lt;b&gt;مقاييس الأداء المستخدمة&lt;/b&gt;&lt;br&gt;• HitRate@5 — نسبة المرات التي ظهر فيها المنتج الصحيح ضمن أول 5&lt;br&gt;• MRR — متوسط ترتيب الظهور الأول (كلما أقرب للمرتبة 1 كان أفضل)&lt;br&gt;• Precision / Recall — دقة واكتمال التوصيات&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=14;fontSize=16;spacing=8;fontFamily=Tahoma;fillColor=#DAE8FC;strokeColor=#6C8EBF;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="80" y="470" width="760" height="180" as="geometry" />
        </mxCell>
        <mxCell id="c14" value="&lt;div dir=&quot;rtl&quot;&gt;&lt;b&gt;لماذا هذا التصميم؟&lt;/b&gt;&lt;br&gt;إخفاء آخر طلب يحاكي سؤالاً واقعياً:&lt;br&gt;«لو الزبون لم يشترِ بعد، هل النظام كان سيقترح له ما سيشتريه فعلاً؟»&lt;br&gt;هذا معيار شائع في أدبيات أنظمة التوصية.&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=14;fontSize=16;spacing=8;fontFamily=Tahoma;fillColor=#FFFFFF;strokeColor=#6A1B4D;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="880" y="470" width="640" height="180" as="geometry" />
        </mxCell>
        <mxCell id="c15" value="&lt;div dir=&quot;rtl&quot;&gt;البيانات مستخرجة من كتالوج تجميل حقيقي + سلوك شراء مُحاكى لشخصيات زبائن متنوعة&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=14;fontSize=16;spacing=8;fontFamily=Tahoma;fillColor=#F8D7E3;strokeColor=#D46A92;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="80" y="680" width="1440" height="55" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
